<?xml version="1.0" encoding="utf-8"?>
<component name="ModalDialog" extends="Group">
    <interface>
        <!-- Set once per open: { title, message, buttons }. Batching these into a single
             field avoids rebuilding the layout once per property. -->
        <field id="content" type="assocarray" />
        <!-- Fired when the user confirms (OK) or cancels (Back). On Back, the last
             button's index is sent - see onKeyEvent in the .bs for the convention. -->
        <field id="buttonSelected" type="integer" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="overlay" color="0x121314FF" width="1920" height="1080" />
        <Rectangle id="panel" />
        <LayoutGroup id="contentGroup" layoutDirection="vert">
            <Label id="titleLabel" horizAlign="center" vertAlign="center"
                font="font:MediumSystemFont" />
            <Label id="messageLabel" horizAlign="center" vertAlign="center"
                font="font:SmallSystemFont" />
            <LayoutGroup id="buttonList" layoutDirection="vert" />
        </LayoutGroup>
    </children>
</component>